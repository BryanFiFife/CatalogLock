{
  "name": "cataloglock",
  "version": "0.3.0",
  "description": "A deterministic security gate and lockfile for ARD v0.91 trust context and complete MCP 2026-07-28 protocol surfaces.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "BryanFiFife",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BryanFiFife/CatalogLock.git"
  },
  "homepage": "https://github.com/BryanFiFife/CatalogLock#readme",
  "bugs": {
    "url": "https://github.com/BryanFiFife/CatalogLock/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cataloglock": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"for(const p of ['dist','.test-dist','.smoke'])require('fs').rmSync(p,{recursive:true,force:true})\"",
    "clean:test": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/make-wrappers.mjs",
    "test": "npm run clean:test && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "coverage": "npm run clean:test && tsc -p tsconfig.test.json && node --experimental-test-coverage --test .test-dist/tests/*.test.js",
    "check": "npm run typecheck && npm test && npm run build",
    "check:tree": "node scripts/check-tree.mjs",
    "check:package": "node scripts/check-package.mjs",
    "release:check": "npm run check && npm run check:tree && npm run check:package",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "a2a",
    "agentic-resource-discovery",
    "ai-agents",
    "ai-catalog",
    "ai-security",
    "ard",
    "ard-v0.91",
    "github-action",
    "lockfile",
    "mcp",
    "mcp-2026-07-28",
    "mcp-prompts",
    "mcp-provenance",
    "mcp-resources",
    "mcp-security",
    "mcp-tools",
    "sarif",
    "ssrf",
    "supply-chain-security",
    "tool-drift",
    "trust-verification"
  ],
  "devDependencies": {
    "@types/node": "24.3.1",
    "typescript": "5.9.2"
  }
}
